generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════
//  AUTENTICACIÓN Y PERMISOS
// ══════════════════════════════════════════

model Usuario {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  email         String        @unique
  password      String
  nombre        String
  estado        Boolean       @default(true)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt      @map("actualizado_en")

  roles                 RolUsuario[]
  menus                 MenuUsuario[]
  ventas                Venta[]
  compras               Compra[]
  ordenes_compra        OrdenCompra[]
  movimientosInventario MovimientoInventario[]
  ajustesInventario     AjusteInventario[]
  transferencias        TransferenciaAlmacen[]
  devolucionesVenta     DevolucionVenta[]
  devolucionesCompra    DevolucionCompra[]
  despachos             Despacho[]
  conteos               ConteoInventario[]

  @@map("usuarios")
}

model Rol {
  id            Int          @id @default(autoincrement())
  codigo        String       @unique
  descripcion   String
  estado        Boolean      @default(true)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt      @map("actualizado_en")

  lista_usuarios RolUsuario[]
  lista_menus    MenuRol[]

  @@map("roles")
}

model RolUsuario {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  rolId     Int      @map("rol_id")
  estado    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  rol       Rol      @relation(fields: [rolId],     references: [id])

  @@unique([usuarioId, rolId])
  @@map("rol_usuarios")
}

model Menu {
  id            Int           @id @default(autoincrement())
  codigo        String        @unique
  descripcion   String
  url           String?
  icono         String?
  orden         Int           @default(0)
  menuPadreId   Int?          @map("menu_padre_id")
  estado        Boolean       @default(true)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt      @map("actualizado_en")

  menuPadre      Menu?         @relation("MenuHijos", fields: [menuPadreId], references: [id])
  hijos          Menu[]        @relation("MenuHijos")
  lista_roles    MenuRol[]
  lista_usuarios MenuUsuario[]

  @@map("menus")
}

model MenuRol {
  id       Int      @id @default(autoincrement())
  menuId   Int      @map("menu_id")
  rolId    Int      @map("rol_id")
  estado   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  menu     Menu     @relation(fields: [menuId], references: [id])
  rol      Rol      @relation(fields: [rolId],  references: [id])

  @@unique([menuId, rolId])
  @@map("menu_roles")
}

model MenuUsuario {
  id        Int      @id @default(autoincrement())
  menuId    Int      @map("menu_id")
  usuarioId Int      @map("usuario_id")
  estado    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")

  menu      Menu     @relation(fields: [menuId],    references: [id])
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([menuId, usuarioId])
  @@map("menu_usuarios")
}

// ══════════════════════════════════════════
//  MAESTRAS  (id, codigo, descripcion, estado, lista)
// ══════════════════════════════════════════

model Marca {
  id            Int        @id @default(autoincrement())
  nombre        String     @unique
  estado        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt      @map("actualizado_en")

  lista           Producto[]
  categoriaLink   CategoriaMarca[]

  @@map("marcas")
}

model TipoPago {
  id            Int       @id @default(autoincrement())
  nombre        String    @unique
  estado        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt      @map("actualizado_en")

  ventas        Venta[]
  compras       Compra[]

  @@map("tipos_pago")
}

model Almacen {
  id            Int        @id @default(autoincrement())
  nombre        String     @unique
  descripcion   String?
  direccion     String?
  estado        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt      @map("actualizado_en")

  lista_productos   Producto[]
  categoriaConfigs  CategoriaConfig[]
  lista_stock       StockAlmacen[]
  lista_movimientos MovimientoInventario[]
  lista_ventas      Venta[]
  lista_compras     Compra[]
  lista_ajustes     AjusteInventario[]
  transferenciasOrigen  TransferenciaAlmacen[] @relation("TransferenciaOrigen")
  transferenciasDestino TransferenciaAlmacen[] @relation("TransferenciaDestino")
  devolucionesVenta     DevolucionVenta[]      @relation("DevolucionVentaAlmacen")
  devolucionesCompra    DevolucionCompra[]     @relation("DevolucionCompraAlmacen")
  conteos               ConteoInventario[]

  @@map("almacenes")
}

// Stock físico de cada producto en cada almacén.
// Producto.stock se mantiene como el total agregado de todos los almacenes.
// stockReservado: comprometido por transferencias pendientes; disponible = stock - stockReservado.
model StockAlmacen {
  id             Int      @id @default(autoincrement())
  productoId     Int      @map("producto_id")
  almacenId      Int      @map("almacen_id")
  stock          Int      @default(0)
  stockReservado Int      @default(0) @map("stock_reservado")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt      @map("actualizado_en")

  producto Producto @relation(fields: [productoId], references: [id])
  almacen  Almacen  @relation(fields: [almacenId],  references: [id])

  @@unique([productoId, almacenId])
  @@map("stock_almacenes")
}

model Caja {
  id            Int       @id @default(autoincrement())
  nombre        String    @unique
  descripcion   String?
  estado        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt      @map("actualizado_en")

  @@map("cajas")
}

model Categoria {
  id            Int        @id @default(autoincrement())
  codigo        String     @unique
  descripcion   String?
  estado        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt      @map("actualizado_en")

  lista                Producto[]
  config               CategoriaConfig?
  categoriaMarcas      CategoriaMarca[]
  categoriaProveedores CategoriaProveedor[]
  lista_orden_items    OrdenCompraItem[]

  @@map("categorias")
}

model UnidadMedida {
  id            Int        @id @default(autoincrement())
  codigo        String     @unique  // UND, KG, MT, LT, GL, ML, CJA, PAQ
  descripcion   String
  estado        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt      @map("actualizado_en")

  lista            Producto[]
  categoriaConfigs CategoriaConfig[]
  conversiones     ProductoUnidadConversion[]
  ventaItems       VentaItem[]
  compraItems      CompraItem[]

  @@map("unidades_medida")
}

// Unidades alternativas por producto: 1 <unidad> = <factor> unidades base del producto.
// Ej.: producto "Cemento" (base: bolsa) con conversión CJA factor 12 → 1 caja = 12 bolsas.
model ProductoUnidadConversion {
  id             Int          @id @default(autoincrement())
  productoId     Int          @map("producto_id")
  unidadMedidaId Int          @map("unidad_medida_id")
  factor         Decimal      @db.Decimal(10, 2)
  estado         Boolean      @default(true)
  creadoEn       DateTime     @default(now()) @map("creado_en")
  actualizadoEn  DateTime     @updatedAt      @map("actualizado_en")

  producto       Producto     @relation(fields: [productoId],     references: [id])
  unidadMedida   UnidadMedida @relation(fields: [unidadMedidaId], references: [id])

  @@unique([productoId, unidadMedidaId])
  @@map("producto_unidad_conversiones")
}

// ══════════════════════════════════════════
//  NEGOCIO
// ══════════════════════════════════════════

model Proveedor {
  id            Int        @id @default(autoincrement())
  codigo        String     @unique
  descripcion   String
  ruc           String?    @unique
  contacto      String?
  email         String?
  telefono      String?
  direccion     String?
  leadTimeDias  Int        @default(0) @map("lead_time_dias")
  estado        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt      @map("actualizado_en")

  lista_productos   Producto[]
  lista_compras     Compra[]
  lista_ordenes     OrdenCompra[]
  categoriaLink     CategoriaProveedor[]

  @@map("proveedores")
}

model Cliente {
  id              Int           @id @default(autoincrement())
  codigo          String        @unique
  descripcion     String
  tipo            TipoCliente   @default(natural)
  tipoDocumento   TipoDocumento @default(DNI)   @map("tipo_documento")
  numeroDocumento String        @unique         @map("numero_documento")
  email           String?
  telefono        String?
  direccion       String?
  estado          Boolean       @default(true)
  creadoEn        DateTime      @default(now()) @map("creado_en")
  actualizadoEn   DateTime      @updatedAt      @map("actualizado_en")

  lista           Venta[]

  @@map("clientes")
}

model Producto {
  id             Int          @id @default(autoincrement())
  codigo         String       @unique
  codigoBarras   String?      @unique @map("codigo_barras")
  descripcion    String
  detalle        String?
  img            String?
  precioCompra   Decimal      @db.Decimal(10, 2) @map("precio_compra")
  precioVenta    Decimal      @db.Decimal(10, 2) @map("precio_venta")
  costoPromedio  Decimal      @default(0) @db.Decimal(10, 2) @map("costo_promedio")
  stock          Int          @default(0)
  stockMinimo    Int          @default(0)         @map("stock_minimo")
  stockMaximo    Int          @default(0)         @map("stock_maximo")
  puntoReorden   Int          @default(0)         @map("punto_reorden")
  ubicacion      String?
  categoriaId    Int          @map("categoria_id")
  marcaId        Int?         @map("marca_id")
  unidadMedidaId Int?         @map("unidad_medida_id")
  proveedorId    Int?         @map("proveedor_id")
  almacenId      Int?         @map("almacen_id")
  estado         Boolean      @default(true)
  creadoEn       DateTime     @default(now())    @map("creado_en")
  actualizadoEn  DateTime     @updatedAt         @map("actualizado_en")

  categoria             Categoria              @relation(fields: [categoriaId],    references: [id])
  marca                 Marca?                 @relation(fields: [marcaId],        references: [id])
  unidadMedida          UnidadMedida?          @relation(fields: [unidadMedidaId], references: [id])
  proveedor             Proveedor?             @relation(fields: [proveedorId],    references: [id])
  almacen               Almacen?               @relation(fields: [almacenId],      references: [id])
  lista_ventas          VentaItem[]
  lista_compras         CompraItem[]
  lista_movimientos     MovimientoInventario[]
  lista_ajustes         AjusteInventarioItem[]
  lista_ordenes         OrdenCompraItem[]
  lista_stock           StockAlmacen[]
  lista_transferencias  TransferenciaAlmacenItem[]
  lista_devoluciones_venta  DevolucionVentaItem[]
  lista_devoluciones_compra DevolucionCompraItem[]
  conversiones          ProductoUnidadConversion[]
  lista_conteos         ConteoInventarioItem[]

  @@map("productos")
}

// ══════════════════════════════════════════
//  TRANSACCIONAL — VENTAS
// ══════════════════════════════════════════

model Venta {
  id            Int         @id @default(autoincrement())
  numero        String      @unique
  clienteId     Int         @map("cliente_id")
  usuarioId     Int         @map("usuario_id")
  almacenId     Int?        @map("almacen_id")
  subtotal      Decimal     @db.Decimal(10, 2)
  igv           Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  tipoPagoId    Int?        @map("tipo_pago_id")
  estado        EstadoVenta @default(pendiente)
  observaciones String?
  creadoEn      DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt      @map("actualizado_en")

  cliente       Cliente     @relation(fields: [clienteId],   references: [id])
  usuario       Usuario     @relation(fields: [usuarioId],   references: [id])
  tipoPago      TipoPago?   @relation(fields: [tipoPagoId],  references: [id])
  almacen       Almacen?    @relation(fields: [almacenId],   references: [id])
  lista         VentaItem[]
  devoluciones  DevolucionVenta[]
  despachos     Despacho[]

  @@map("ventas")
}

model VentaItem {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  productoId     Int      @map("producto_id")
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2) @map("precio_unitario")
  subtotal       Decimal  @db.Decimal(10, 2)
  // Unidad en la que se vendió y su equivalencia en unidades base (1 = unidad base)
  unidadMedidaId Int?     @map("unidad_medida_id")
  factorUnidad   Decimal  @default(1) @db.Decimal(10, 2) @map("factor_unidad")
  estado         Boolean  @default(true)

  venta          Venta         @relation(fields: [ventaId],    references: [id])
  producto       Producto      @relation(fields: [productoId], references: [id])
  unidadMedida   UnidadMedida? @relation(fields: [unidadMedidaId], references: [id])

  @@map("venta_items")
}

// ══════════════════════════════════════════
//  TRANSACCIONAL — COMPRAS
// ══════════════════════════════════════════

model Compra {
  id            Int          @id @default(autoincrement())
  numero        String       @unique
  proveedorId   Int          @map("proveedor_id")
  usuarioId     Int          @map("usuario_id")
  almacenId     Int?         @map("almacen_id")
  subtotal      Decimal      @db.Decimal(10, 2)
  igv           Decimal      @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  tipoPagoId    Int?         @map("tipo_pago_id")
  estado        EstadoCompra @default(pendiente)
  numeroFactura String?      @map("numero_factura")
  observaciones String?
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt      @map("actualizado_en")

  proveedor     Proveedor    @relation(fields: [proveedorId], references: [id])
  usuario       Usuario      @relation(fields: [usuarioId],   references: [id])
  tipoPago      TipoPago?    @relation(fields: [tipoPagoId],  references: [id])
  almacen       Almacen?     @relation(fields: [almacenId],   references: [id])
  lista         CompraItem[]
  devoluciones  DevolucionCompra[]

  @@map("compras")
}

model CompraItem {
  id            Int      @id @default(autoincrement())
  compraId      Int      @map("compra_id")
  productoId    Int      @map("producto_id")
  cantidad      Int
  // Cantidad ya ingresada al stock (en la unidad del documento); < cantidad = backorder pendiente
  cantidadRecibida Int   @default(0) @map("cantidad_recibida")
  costoUnitario Decimal  @db.Decimal(10, 2) @map("costo_unitario")
  subtotal      Decimal  @db.Decimal(10, 2)
  // Unidad en la que se compró y su equivalencia en unidades base (1 = unidad base)
  unidadMedidaId Int?    @map("unidad_medida_id")
  factorUnidad   Decimal @default(1) @db.Decimal(10, 2) @map("factor_unidad")
  estado        Boolean  @default(true)

  compra        Compra        @relation(fields: [compraId],    references: [id])
  producto      Producto      @relation(fields: [productoId],  references: [id])
  unidadMedida  UnidadMedida? @relation(fields: [unidadMedidaId], references: [id])

  @@map("compra_items")
}

// ══════════════════════════════════════════
//  TRANSACCIONAL — INVENTARIO (KARDEX)
// ══════════════════════════════════════════

model MovimientoInventario {
  id             Int            @id @default(autoincrement())
  productoId     Int            @map("producto_id")
  almacenId      Int?           @map("almacen_id")
  tipo           TipoMovimiento
  cantidad       Int
  costoUnitario  Decimal?       @db.Decimal(10, 2) @map("costo_unitario")
  stockAnterior  Int            @map("stock_anterior")
  stockNuevo     Int            @map("stock_nuevo")
  referenciaId   Int?           @map("referencia_id")
  referenciaTipo String?        @map("referencia_tipo")
  observacion    String?
  usuarioId      Int            @map("usuario_id")
  estado         Boolean        @default(true)
  creadoEn       DateTime       @default(now()) @map("creado_en")

  producto       Producto       @relation(fields: [productoId], references: [id])
  almacen        Almacen?       @relation(fields: [almacenId],  references: [id])
  usuario        Usuario        @relation(fields: [usuarioId],  references: [id])

  @@map("movimientos_inventario")
}

model AjusteInventario {
  id            Int                    @id @default(autoincrement())
  numero        String                 @unique
  motivo        String
  usuarioId     Int                    @map("usuario_id")
  almacenId     Int?                   @map("almacen_id")
  estado        EstadoAjuste           @default(borrador)
  observaciones String?
  creadoEn      DateTime               @default(now()) @map("creado_en")
  actualizadoEn DateTime               @updatedAt      @map("actualizado_en")

  usuario       Usuario                @relation(fields: [usuarioId], references: [id])
  almacen       Almacen?               @relation(fields: [almacenId], references: [id])
  lista         AjusteInventarioItem[]

  @@map("ajustes_inventario")
}

model AjusteInventarioItem {
  id           Int              @id @default(autoincrement())
  ajusteId     Int              @map("ajuste_id")
  productoId   Int              @map("producto_id")
  stockSistema Int              @map("stock_sistema")
  stockFisico  Int              @map("stock_fisico")
  diferencia   Int
  estado       Boolean          @default(true)

  ajuste       AjusteInventario @relation(fields: [ajusteId],   references: [id])
  producto     Producto         @relation(fields: [productoId], references: [id])

  @@map("ajuste_inventario_items")
}

// ══════════════════════════════════════════
//  REGLAS DE NEGOCIO — TABLAS PUENTE
// ══════════════════════════════════════════

// Defaults por categoría: unidad de medida y almacén predeterminados
model CategoriaConfig {
  id             Int           @id @default(autoincrement())
  categoriaId    Int           @unique @map("categoria_id")
  unidadMedidaId Int?          @map("unidad_medida_id")
  almacenId      Int?          @map("almacen_id")
  creadoEn       DateTime      @default(now()) @map("creado_en")
  actualizadoEn  DateTime      @updatedAt      @map("actualizado_en")

  categoria    Categoria     @relation(fields: [categoriaId],    references: [id])
  unidadMedida UnidadMedida? @relation(fields: [unidadMedidaId], references: [id])
  almacen      Almacen?      @relation(fields: [almacenId],      references: [id])

  @@map("categoria_configs")
}

// Marcas habituales de una categoría (N:M)
model CategoriaMarca {
  categoriaId Int @map("categoria_id")
  marcaId     Int @map("marca_id")

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  marca     Marca     @relation(fields: [marcaId],     references: [id], onDelete: Cascade)

  @@id([categoriaId, marcaId])
  @@map("categoria_marcas")
}

// Proveedores habituales de una categoría (N:M)
model CategoriaProveedor {
  categoriaId Int @map("categoria_id")
  proveedorId Int @map("proveedor_id")

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@id([categoriaId, proveedorId])
  @@map("categoria_proveedores")
}

// ══════════════════════════════════════════
//  ENUMS
// ══════════════════════════════════════════

enum TipoCliente {
  natural
  juridica
}

enum TipoDocumento {
  DNI
  RUC
  CE
  Carnet_Extranjeria
}

enum EstadoVenta {
  pendiente
  completada
  anulada
}

enum EstadoCompra {
  pendiente
  parcial
  recibida
  anulada
}

enum TipoMovimiento {
  entrada_compra
  salida_venta
  entrada_ajuste
  salida_ajuste
  entrada_manual
  salida_manual
  entrada_transferencia
  salida_transferencia
  entrada_devolucion_venta
  salida_devolucion_compra
}

enum EstadoAjuste {
  borrador
  aplicado
  anulado
}

enum EstadoOrden {
  borrador
  enviada
  recibida
  anulada
}

enum EstadoTransferencia {
  pendiente
  enviada
  recibida
  anulada
}

enum EstadoDevolucion {
  registrada
  anulada
}

enum EstadoDespacho {
  pendiente
  en_preparacion
  despachado
  entregado
  anulado
}

// ══════════════════════════════════════════
//  ÓRDENES DE COMPRA A PROVEEDOR
// ══════════════════════════════════════════

model OrdenCompra {
  id             Int            @id @default(autoincrement())
  numero         String         @unique
  proveedorId    Int            @map("proveedor_id")
  usuarioId      Int            @map("usuario_id")
  estado         EstadoOrden    @default(borrador)
  observaciones  String?
  correoEnviado  Boolean        @default(false) @map("correo_enviado")
  fechaEnvio     DateTime?      @map("fecha_envio")
  fechaRecepcion DateTime?      @map("fecha_recepcion")
  creadoEn       DateTime       @default(now()) @map("creado_en")
  actualizadoEn  DateTime       @updatedAt      @map("actualizado_en")

  proveedor      Proveedor       @relation(fields: [proveedorId], references: [id])
  usuario        Usuario         @relation(fields: [usuarioId],   references: [id])
  lista          OrdenCompraItem[]

  @@map("ordenes_compra")
}

// ══════════════════════════════════════════
//  LOGÍSTICA — TRANSFERENCIAS, DEVOLUCIONES Y DESPACHOS
// ══════════════════════════════════════════

model TransferenciaAlmacen {
  id             Int                        @id @default(autoincrement())
  numero         String                     @unique
  almacenOrigenId  Int                      @map("almacen_origen_id")
  almacenDestinoId Int                      @map("almacen_destino_id")
  usuarioId      Int                        @map("usuario_id")
  estado         EstadoTransferencia        @default(pendiente)
  observaciones  String?
  fechaEnvio     DateTime?                  @map("fecha_envio")
  fechaRecepcion DateTime?                  @map("fecha_recepcion")
  creadoEn       DateTime                   @default(now()) @map("creado_en")
  actualizadoEn  DateTime                   @updatedAt      @map("actualizado_en")

  almacenOrigen  Almacen                    @relation("TransferenciaOrigen",  fields: [almacenOrigenId],  references: [id])
  almacenDestino Almacen                    @relation("TransferenciaDestino", fields: [almacenDestinoId], references: [id])
  usuario        Usuario                    @relation(fields: [usuarioId], references: [id])
  lista          TransferenciaAlmacenItem[]

  @@map("transferencias_almacen")
}

model TransferenciaAlmacenItem {
  id              Int                  @id @default(autoincrement())
  transferenciaId Int                  @map("transferencia_id")
  productoId      Int                  @map("producto_id")
  cantidad        Int
  estado          Boolean              @default(true)

  transferencia   TransferenciaAlmacen @relation(fields: [transferenciaId], references: [id])
  producto        Producto             @relation(fields: [productoId],      references: [id])

  @@map("transferencia_almacen_items")
}

model DevolucionVenta {
  id            Int                   @id @default(autoincrement())
  numero        String                @unique
  ventaId       Int                   @map("venta_id")
  almacenId     Int                   @map("almacen_id")
  usuarioId     Int                   @map("usuario_id")
  motivo        String
  estado        EstadoDevolucion      @default(registrada)
  observaciones String?
  total         Decimal               @db.Decimal(10, 2)
  creadoEn      DateTime              @default(now()) @map("creado_en")
  actualizadoEn DateTime              @updatedAt      @map("actualizado_en")

  venta         Venta                 @relation(fields: [ventaId],   references: [id])
  almacen       Almacen               @relation("DevolucionVentaAlmacen", fields: [almacenId], references: [id])
  usuario       Usuario               @relation(fields: [usuarioId], references: [id])
  lista         DevolucionVentaItem[]

  @@map("devoluciones_venta")
}

model DevolucionVentaItem {
  id             Int             @id @default(autoincrement())
  devolucionId   Int             @map("devolucion_id")
  productoId     Int             @map("producto_id")
  cantidad       Int
  precioUnitario Decimal         @db.Decimal(10, 2) @map("precio_unitario")
  subtotal       Decimal         @db.Decimal(10, 2)
  estado         Boolean         @default(true)

  devolucion     DevolucionVenta @relation(fields: [devolucionId], references: [id])
  producto       Producto        @relation(fields: [productoId],   references: [id])

  @@map("devolucion_venta_items")
}

model DevolucionCompra {
  id            Int                    @id @default(autoincrement())
  numero        String                 @unique
  compraId      Int                    @map("compra_id")
  almacenId     Int                    @map("almacen_id")
  usuarioId     Int                    @map("usuario_id")
  motivo        String
  estado        EstadoDevolucion       @default(registrada)
  observaciones String?
  total         Decimal                @db.Decimal(10, 2)
  creadoEn      DateTime               @default(now()) @map("creado_en")
  actualizadoEn DateTime               @updatedAt      @map("actualizado_en")

  compra        Compra                 @relation(fields: [compraId],  references: [id])
  almacen       Almacen                @relation("DevolucionCompraAlmacen", fields: [almacenId], references: [id])
  usuario       Usuario                @relation(fields: [usuarioId], references: [id])
  lista         DevolucionCompraItem[]

  @@map("devoluciones_compra")
}

model DevolucionCompraItem {
  id            Int              @id @default(autoincrement())
  devolucionId  Int              @map("devolucion_id")
  productoId    Int              @map("producto_id")
  cantidad      Int
  costoUnitario Decimal          @db.Decimal(10, 2) @map("costo_unitario")
  subtotal      Decimal          @db.Decimal(10, 2)
  estado        Boolean          @default(true)

  devolucion    DevolucionCompra @relation(fields: [devolucionId], references: [id])
  producto      Producto         @relation(fields: [productoId],   references: [id])

  @@map("devolucion_compra_items")
}

model Despacho {
  id               Int            @id @default(autoincrement())
  numero           String         @unique
  ventaId          Int            @map("venta_id")
  usuarioId        Int            @map("usuario_id")
  direccionEntrega String         @map("direccion_entrega")
  contacto         String?
  telefono         String?
  transportista    String?
  observaciones    String?
  estado           EstadoDespacho @default(pendiente)
  fechaDespacho    DateTime?      @map("fecha_despacho")
  fechaEntrega     DateTime?      @map("fecha_entrega")
  creadoEn         DateTime       @default(now()) @map("creado_en")
  actualizadoEn    DateTime       @updatedAt      @map("actualizado_en")

  venta            Venta          @relation(fields: [ventaId],   references: [id])
  usuario          Usuario        @relation(fields: [usuarioId], references: [id])

  @@map("despachos")
}

// ══════════════════════════════════════════
//  CONTEOS CÍCLICOS / INVENTARIO FÍSICO
// ══════════════════════════════════════════

enum EstadoConteo {
  abierto   // planilla generada, en proceso de conteo
  aplicado  // diferencias ajustadas al stock
  anulado
}

model ConteoInventario {
  id              Int           @id @default(autoincrement())
  numero          String        @unique
  almacenId       Int           @map("almacen_id")
  usuarioId       Int           @map("usuario_id")
  estado          EstadoConteo  @default(abierto)
  observaciones   String?
  fechaAplicacion DateTime?     @map("fecha_aplicacion")
  creadoEn        DateTime      @default(now()) @map("creado_en")
  actualizadoEn   DateTime      @updatedAt      @map("actualizado_en")

  almacen         Almacen       @relation(fields: [almacenId], references: [id])
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  lista           ConteoInventarioItem[]

  @@map("conteos_inventario")
}

model ConteoInventarioItem {
  id           Int  @id @default(autoincrement())
  conteoId     Int  @map("conteo_id")
  productoId   Int  @map("producto_id")
  // Stock del sistema capturado al generar la planilla (unidades base)
  stockSistema Int  @map("stock_sistema")
  // Stock contado físicamente; null = aún sin contar
  stockFisico  Int? @map("stock_fisico")

  conteo       ConteoInventario @relation(fields: [conteoId],   references: [id])
  producto     Producto         @relation(fields: [productoId], references: [id])

  @@unique([conteoId, productoId])
  @@map("conteo_inventario_items")
}

model OrdenCompraItem {
  id                  Int       @id @default(autoincrement())
  ordenCompraId       Int       @map("orden_compra_id")
  productoId          Int?      @map("producto_id")
  descripcion         String
  detalles            String?
  cantidad            Int
  cantidadRecibida    Int       @default(0)  @map("cantidad_recibida")
  costoUnitario       Decimal   @db.Decimal(10, 2) @map("costo_unitario")
  subtotal            Decimal   @db.Decimal(10, 2)
  esNuevoProducto     Boolean   @default(false) @map("es_nuevo_producto")
  precioVentaSugerido Decimal?  @db.Decimal(10, 2) @map("precio_venta_sugerido")
  categoriaId         Int?      @map("categoria_id")
  estado              Boolean   @default(true)

  ordenCompra         OrdenCompra  @relation(fields: [ordenCompraId], references: [id])
  producto            Producto?    @relation(fields: [productoId],    references: [id])
  categoria           Categoria?   @relation(fields: [categoriaId],   references: [id])

  @@map("orden_compra_items")
}
